generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("STORAGE_DATABASE_URL")
  directUrl = env("STORAGE_POSTGRES_URL")
}

enum Role {
  STUDENT
  TEACHER
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id                 String              @id
  email              String              @unique
  passwordHash       String?
  googleId           String?             @unique
  name               String?
  role               Role                @default(STUDENT)
  imageUrl           String?
  dateOfBirth        DateTime?
  phone              String?
  bio                String?
  gender             Gender?
  emailVerified      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  editorProfile      EditorProfile?
  verificationTokens VerificationToken[]
}

model VerificationToken {
  id        String                @id @default(uuid())
  userId    String
  tokenHash String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Course {
  id          String       @id @default(uuid())
  userId      String
  title       String
  description String?
  imageUrl    String?
  price       Float?
  isPublished Boolean      @default(false)
  categoryId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  chapters    Chapter[]
  category    Category?    @relation(fields: [categoryId], references: [id])
  groupUrls   GroupUrl[]
  lectures    Lecture[]
  fibPayments FibPayment[]
  purchases   Purchase[]
  teachers    Teacher[]    @relation("CourseToTeacher")

  @@index([categoryId])
}

model GroupUrl {
  id         String   @id @default(uuid())
  name       String   @default("")
  url        String
  studentIds String[] @default([])
  courseId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  iconUrl   String?
  courses   Course[]
}

model Attachment {
  id        String   @id @default(uuid())
  name      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  key       String
  chapterId String?
  isFree    Boolean  @default(false)
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

model Chapter {
  id           String         @id @default(uuid())
  title        String
  description  String?
  videoUrl     String?
  position     Int
  isPublished  Boolean        @default(false)
  isFree       Boolean        @default(false)
  courseId     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lectureId    String?
  attachments  Attachment[]
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecture      Lecture?       @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  muxData      MuxData?
  userProgress UserProgress[]

  @@index([courseId])
  @@index([lectureId])
}

model Lecture {
  id        String    @id @default(uuid())
  title     String
  position  Int
  courseId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  chapters  Chapter[]
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Teacher {
  id          String         @id @default(uuid())
  name        String
  title       String?
  bio         String?
  profileUrl  String?
  coverUrl    String?
  socialLinks String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  isPublished Boolean        @default(false)
  courses     Course[]       @relation("CourseToTeacher")
  editor      EditorProfile?
}

model MuxData {
  id         String  @id @default(uuid())
  assetId    String
  playbackId String?
  // Runtime in seconds, cached from the Mux API on first read. Mux only knows
  // it once the asset finishes processing, so it fills in lazily.
  duration   Float?
  chapterId  String  @unique
  chapter    Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id          String   @id @default(uuid())
  userId      String
  chapterId   String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([chapterId])
}

model Purchase {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

enum FibPaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

/// FIB card payments. This model was recovered from the live database — it
/// exists in Postgres with real rows but had never been committed here, which
/// made `prisma db push` a destructive operation. Keep it in sync.
model FibPayment {
  id                String           @id
  orderId           String           @unique
  paymentId         String?          @unique
  userId            String
  courseId          String
  amount            Int
  currency          String           @default("IQD")
  status            FibPaymentStatus @default(PENDING)
  platform          String           @default("web")
  reference         String?
  authorizationCode String?
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([userId, courseId])
  @@index([userId])
}

model StripeCustomer {
  id               String   @id @default(uuid())
  userId           String   @unique
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Journal
//
// Visitor-written articles, moderated by the admin (NEXT_PUBLIC_TEACHER_ID).
// Content is Arabic long-form, so the writing and reading surfaces are RTL —
// see components/journal/ and the .prose-article block in globals.css.
// ---------------------------------------------------------------------------

enum ArticleStatus {
  DRAFT // author still writing; the admin never sees it
  PENDING // submitted, sitting in the admin queue
  CHANGES_REQUESTED // sent back with reasons; the author edits and resubmits
  SCHEDULED // approved, goes live at publishedAt (the cron flips it)
  PUBLISHED // live
  ARCHIVED // taken down after having been live
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

/// The author identity. Separate from User so an editor can present a pen
/// name, their own avatar and socials — and so the planned /editors page has
/// something to list.
model EditorProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  /// Defaults from User.name at first submission, editable afterwards.
  displayName String
  /// Author-supplied. Falls back to User.imageUrl, then generated initials.
  avatarUrl   String?
  bio         String?
  instagram   String?
  facebook    String?
  website     String?
  /// Set when the author is also an academy master — drives the "visit their
  /// page" link on the article.
  teacherId   String?   @unique
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
  teacher     Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Admin-managed. Labels are English for now; nameAr is the optional Arabic
/// label the public journal prefers when it is set.
model JournalCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  nameAr    String?
  slug      String    @unique
  position  Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
}

model Article {
  id               String            @id @default(uuid())
  slug             String            @unique
  title            String
  /// Plain text, derived on save — powers cards and the meta description.
  excerpt          String?
  coverUrl         String?
  /// UploadThing key, so the cleanup cron can tell a live cover from an orphan.
  coverKey         String?
  /// Sanitised HTML from Tiptap. Never rendered without passing through
  /// lib/journal/sanitize.ts first.
  contentHtml      String
  /// Plain-text mirror of contentHtml; what the Fuse search actually indexes.
  contentText      String
  status           ArticleStatus     @default(DRAFT)
  authorId         String
  categoryId       String?
  /// Free text when the author picked "Other"; the admin resolves it at review.
  proposedCategory String?
  readingMinutes   Int?
  /// Denormalised from ArticleView so reads stay O(1).
  viewCount        Int               @default(0)
  submittedAt      DateTime?
  /// When it went live, or — while SCHEDULED — when it is due to.
  publishedAt      DateTime?
  termsVersion     String?
  termsAcceptedAt  DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  author           EditorProfile     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category         JournalCategory?  @relation(fields: [categoryId], references: [id])
  resources        ArticleResource[]
  reviews          ArticleReview[]
  views            ArticleView[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
}

/// Every round of moderation, kept as history so the author can see each pass
/// of feedback rather than only the latest.
model ArticleReview {
  id         String         @id @default(uuid())
  articleId  String
  reviewerId String
  decision   ReviewDecision
  /// Reason codes from the fixed list in lib/journal/reviewReasons.ts.
  reasons    String[]
  note       String?
  createdAt  DateTime       @default(now())
  article    Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model ArticleResource {
  id        String   @id @default(uuid())
  articleId String
  label     String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model ArticleView {
  id         String   @id @default(uuid())
  articleId  String
  /// sha256(ip + user-agent + daily salt) — deduplicates without storing PII.
  visitorKey String
  viewedAt   DateTime @default(now())
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, visitorKey])
  @@index([articleId])
}
